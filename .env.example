# Copy to .env and adjust.
POSTGRES_USER=uni
POSTGRES_PASSWORD=change-me-please
POSTGRES_PORT=5432
GATEWAY_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me-too
# Fault-tolerance tunables (see docs/architecture.md "Configuration reference")
HTTP_TIMEOUT_S=1.0
RETRY_ATTEMPTS=3
DOWNSTREAM_DEADLINE_S=2.0
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_S=5.0
DB_RETRY_DEADLINE_S=6.0
MAX_INFLIGHT=60
DEGRADE_INFLIGHT=30
GATEWAY_MAX_INFLIGHT=100
PAYMENT_LEASE_S=1.5
PAYMENT_ROLLBACK_AFTER_S=6.0
# Enables /admin/fault endpoints and the X-Fault header. NEVER enable in production.
ENABLE_FAULT_INJECTION=1
