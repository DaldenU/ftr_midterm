{
 "uid": "uni-ft",
 "title": "University IS - Fault Tolerance",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-10m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request rate by service",
   "description": "Throughput; a drop to 0 for a service signals an outage.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_total[15s]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error rate (5xx) by service",
   "description": "Failed requests per second, the main failure indicator.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_requests_failed_total[15s]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p95 by service",
   "description": "Tail latency; grows under overload or slow dependencies.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[30s])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Service/instance availability (up)",
   "description": "1 = scrape OK. Used for fault DETECTION.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "up",
     "legendFormat": "{{job}} {{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Database connectivity (db_up)",
   "description": "Per instance: did the last DB operation succeed?",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "db_up",
     "legendFormat": "{{service}} {{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "circuit_breaker_state",
     "legendFormat": "{{service}} {{instance}} -> {{target}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Recovery events",
   "description": "payment_resumed, payment_rollback, db_reconnected, breaker_closed, backend_restored",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (type) (increase(recovery_events_total[1m]))",
     "legendFormat": "{{type}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Degraded responses & load shedding",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (reason) (rate(degraded_responses_total[15s]))",
     "legendFormat": "degraded: {{reason}}",
     "refId": "A"
    },
    {
     "expr": "sum(rate(load_shed_total[15s])) + sum(rate(gateway_load_shed_total[15s]))",
     "legendFormat": "shed (503+Retry-After)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Retries performed",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (target) (rate(retries_total[15s]))",
     "legendFormat": "{{target}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Idempotent replays (duplicates absorbed)",
   "description": "Duplicate requests answered from the stored result instead of being processed twice.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(increase(idempotent_replays_total[1m]))",
     "legendFormat": "replays/min",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Gateway: backend up / failovers",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "expr": "gateway_backend_up",
     "legendFormat": "{{service}} {{backend}}",
     "refId": "A"
    },
    {
     "expr": "sum by (service) (increase(gateway_failovers_total[1m]))",
     "legendFormat": "failovers {{service}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ],
 "tags": [
  "fault-tolerance"
 ]
}